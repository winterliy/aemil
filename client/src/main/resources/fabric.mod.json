{
  "schemaVersion": 1,
  "id": "aemil",
  "version": "${version}",
  "name": "Aemil Client",
  "description": "A Fabric-based Minecraft client with integrated Aemil features.",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.aemil.client.AemilClient"
      }
    ]
  },
  "mixins": [
    "aemil.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/fabric-language-kotlin.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "=26.3",
    "java": ">=25",
    "fabric-api": ">=0.162.0+26.3",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21"
  }
}
