{
  "schemaVersion": 1,
  "id": "aemil-loader",
  "version": "${version}",
  "name": "Aemil Loader",
  "description": "Aemil's integrated Minecraft loader and client features.",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.aemil.client.AemilClient"
      }
    ]
  },
  "mixins": [
    "aemil.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "=26.3",
    "java": ">=25",
    "fabric-api": ">=0.162.0+26.3",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21"
  }
}
